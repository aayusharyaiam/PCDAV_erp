PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development
# Example credentials are exclusively for the local development database.
DATABASE_URL=postgresql://pcdav:pcdav_local@localhost:5433/pcdav?schema=public
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Production: STORAGE_DRIVER=s3; supply S3_BUCKET, S3_REGION and AWS credentials.
# S3_ENDPOINT is optional for S3-compatible providers.
SEED_SUPERADMIN_EMAIL=superadmin@pcdav.local
SEED_SUPERADMIN_PASSWORD=ReplaceThisLocalPassword!
